# Copie este arquivo para ".env" e preencha com suas chaves.

# TMDB — crie uma conta em https://www.themoviedb.org e gere a credencial em
# Configurações > API. Aceita tanto o "Token de Leitura da API" (v4, começa
# com "eyJ") quanto a "Chave da API" (v3, 32 caracteres).
EXPO_PUBLIC_TMDB_API_KEY=

# Supabase — crie um projeto gratuito em https://supabase.com/dashboard.
# Os dois valores ficam em Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Facebook App ID — necessário só para o link clicável no compartilhamento do
# Instagram Stories (opcional: sem isso, o app cai direto na folha de
# compartilhar nativa, sem o atalho do Instagram). Crie um app grátis em
# https://developers.facebook.com/apps, tipo "Nenhum"/"Consumidor", e copie o
# "ID do aplicativo" nas configurações básicas.
EXPO_PUBLIC_FACEBOOK_APP_ID=
